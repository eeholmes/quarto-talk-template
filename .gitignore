# under _extensions/ are not ignored.
/*.html
/*_files/
/talk-fonts/
/_site/
/.quarto/
/*.pdf
# ...and the same for decks and posters one folder down (poster/, talk folders)
/*/*.html
/*/*_files/
/*/talk-fonts/
/*/*.pdf
/*/*.typ

# Python
__pycache__/
.venv/

